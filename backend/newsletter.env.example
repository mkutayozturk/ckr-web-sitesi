# Existing ADMIN_JWT_SECRET is reused if NEWSLETTER_TOKEN_SECRET is omitted.
# Keep all values server-side; never place them in React environment variables.
NEWSLETTER_TOKEN_SECRET=
# Leave delivery disabled until provider, permission/İYS and transfer checks are complete.
NEWSLETTER_DELIVERY_ENABLED=false
NEWSLETTER_LEGAL_REVIEWED=false
# Email: existing SMTP_* settings OR Resend (one of the two is sufficient).
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
# WhatsApp Business Cloud API: approved marketing template with document header,
# body variable 1 = date, body variable 2 = full management/opt-out URL.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_NEWSLETTER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=tr
